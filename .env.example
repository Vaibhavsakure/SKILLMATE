# ============================================================
# Skillmate AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control!
# ============================================================

# ─────────────────────────────────────────────────────────────
# 1. GENERAL
# ─────────────────────────────────────────────────────────────

# Application environment: development | staging | production
ENV=development

# Enable debug logging (set to false in production)
DEBUG=true

# Secret key for signing tokens and session data
# In production, generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# REQUIRED in production — auto-generated in development if blank
SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# 2. DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────

# PostgreSQL credentials (used by docker-compose for the postgres service)
POSTGRES_DB=skillmate
POSTGRES_USER=skillmate
POSTGRES_PASSWORD=change_me_in_production

# Override the host port for postgres (default: 5432)
# POSTGRES_PORT=5432

# Full database connection string
# In Docker Compose, this is auto-constructed from POSTGRES_* vars above.
# Only set this if you're NOT using Docker Compose (e.g., managed cloud DB).
# DATABASE_URL=postgresql://skillmate:password@localhost:5432/skillmate

# ─────────────────────────────────────────────────────────────
# 3. SUPABASE (Authentication & Storage)
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe for client-side use, row-level security enforced)
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Service role key (server-side only — full admin access, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# Frontend-facing Supabase keys (baked into Next.js client bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Enable mock auth for local development without Supabase (NEVER true in production)
ALLOW_DEV_MOCK_AUTH=false

# ─────────────────────────────────────────────────────────────
# 4. AI PROVIDERS
# ─────────────────────────────────────────────────────────────

# Anthropic Claude API Key (primary AI provider)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Groq API Key (fast cloud fallback)
# Get from: https://console.groq.com/
GROQ_API_KEY=gsk_...

# Google Gemini API Key (optional)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=

# Ollama local LLM base URL (optional offline fallback)
# Default: http://localhost:11434 (Docker: http://host.docker.internal:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────
# 5. STRIPE (Payments)
# ─────────────────────────────────────────────────────────────

# Stripe Secret Key (server-side only)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Signing Secret
# Get from: https://dashboard.stripe.com/webhooks → your endpoint → Signing secret
# REQUIRED in production for payment verification
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Publishable Key (client-side, safe to expose)
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─────────────────────────────────────────────────────────────
# 6. FRONTEND CONFIGURATION
# ─────────────────────────────────────────────────────────────

# The public URL where the frontend is accessible
# Used for Stripe redirects, CORS origins, email links, etc.
FRONTEND_URL=http://localhost:3000

# API base URL for frontend API calls
# Default: /api/python (proxied via Next.js rewrites)
NEXT_PUBLIC_API_BASE_URL=/api/python

# WebSocket URL for voice interview (direct connection, no proxy)
# In production, use wss:// with your actual domain
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─────────────────────────────────────────────────────────────
# 7. DOCKER COMPOSE (Port overrides)
# ─────────────────────────────────────────────────────────────

# Override default service ports (uncomment to change)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────
# 8. REDIS (Cache & Task Queue)
# ─────────────────────────────────────────────────────────────

# Redis connection URL (auto-set in Docker Compose).
# Used by BOTH the response cache and the ARQ task queue — the API and the
# worker must point at the same instance.
# REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────
# 9. FILE UPLOADS & CLOUD STORAGE (S3 / Cloudflare R2)
# ─────────────────────────────────────────────────────────────
#
# ⚠️  WITHOUT S3/R2 CONFIGURED, uploaded files are saved to
#     /tmp/uploads inside the container and LOST on every restart.
#
# ── Recommended: Cloudflare R2 ───────────────────────────────
# Why R2 over AWS S3?
#   • Zero egress fees (S3 charges ~$0.09/GB out)
#   • Same S3-compatible API — works with boto3, no SDK changes
#   • $0.015/GB storage (same as S3 Standard)
#   • Free tier: 10 GB storage, 10M read ops/month
#
# Setup: https://dash.cloudflare.com → R2 → Create bucket
# Then create an API token with "R2 Read/Write" permissions.
#
# ── Cloudflare R2 configuration ──────────────────────────────
S3_BUCKET_NAME=skillmate-uploads
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
# Find your account_id in Cloudflare Dashboard → Right sidebar
AWS_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Optional: Custom domain for public file URLs (R2 public bucket or CDN)
# If not set, falls back to standard S3 path-style URLs
# S3_PUBLIC_URL=https://files.skillmate.ai

# AWS region (use "auto" for R2, "us-east-1" for AWS S3)
S3_REGION=auto

# ── AWS S3 configuration (alternative to R2) ─────────────────
# Uncomment and fill these instead if you prefer AWS S3:
# S3_BUCKET_NAME=skillmate-uploads
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_REGION=us-east-1
# (Leave AWS_ENDPOINT_URL blank for standard AWS S3)

# Maximum upload file size in MB (enforced before S3 upload)
MAX_FILE_SIZE_MB=10

# ─────────────────────────────────────────────────────────────
# 9b. ADMIN & OBSERVABILITY ACCESS
# ─────────────────────────────────────────────────────────────

# Who may call /api/v1/admin/*. Comma-separated user IDs or emails.
# Users with users.is_superuser = true also qualify. If neither is set,
# the admin endpoints are closed to everyone.
# ADMIN_USER_IDS=you@example.com

# Shared secret required by GET /metrics in production, sent as the
# X-Metrics-Token header. Unset in production disables the endpoint.
# METRICS_TOKEN=change-me-to-a-long-random-string

# ─────────────────────────────────────────────────────────────
# 10. EMAIL (Future — SMTP Configuration)
# ─────────────────────────────────────────────────────────────

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@skillmate.ai

# ─────────────────────────────────────────────────────────────
# 11. MONITORING (Sentry)
# ─────────────────────────────────────────────────────────────
# Get your DSN from: https://sentry.io → Project → Settings → Client Keys

# Backend Sentry (FastAPI)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.2   # 20% of transactions are traced (0.0–1.0)
# SENTRY_PROFILES_SAMPLE_RATE=0.1 # 10% profiling (requires sentry-sdk[profiling])

# Frontend Sentry (Next.js browser SDK)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_RELEASE=skillmate@3.0.0

# ─────────────────────────────────────────────────────────────
# 12. DOMAIN & SSL (Production — Nginx + Let's Encrypt)
# ─────────────────────────────────────────────────────────────
# Your production domain name (no https://, no trailing slash)
DOMAIN_NAME=skillmate.ai

# Email for Let's Encrypt expiry notifications
EMAIL=admin@skillmate.ai

# Set to "on" to enable HTTPS in nginx (requires valid certs first)
# Set to "off" (or leave blank) for local HTTP-only dev
SSL_MODE=off

# Full frontend URL (used for Stripe redirects, CORS, email links)
FRONTEND_URL=https://skillmate.ai
